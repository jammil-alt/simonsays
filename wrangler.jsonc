{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "homework-desk",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],

  // Served only on the custom domain, which sits behind Cloudflare Access.
  // workers.dev and preview URLs are off so nothing reaches the data around Access.
  "routes": [{ "pattern": "simonswork.app", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,

  // The UI is plain static files. Only /api/* and /img/* run the Worker.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/img/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "homework-db",
      "database_id": "9cc65156-3a58-415a-a3f2-73e7ca83f67c",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    { "binding": "PAGES", "bucket_name": "homework-pages" }
  ],

  "vars": {
    // Model used for clean copies. Change here (or in the dashboard) without a code change.
    "CLAUDE_MODEL": "claude-opus-5-5",
    // low | medium | high. Reading a worksheet rarely needs more than medium.
    "CLAUDE_EFFORT": "medium",
    // Small, cheap model that reads 1–3 tags (subject, topic) off each uploaded page for the sidebar filter.
    "CLAUDE_TAG_MODEL": "claude-haiku-5-5",
    // Comic Maker. Art uses Gemini ("Nano Banana Pro"); add the GEMINI_API_KEY secret to turn it on.
    // Check the current model id in Google AI Studio and change it here if Google renames it.
    "GEMINI_IMAGE_MODEL": "gemini-3-pro-image-preview",
    // How many comics Simon can make per day.
    "COMIC_DAILY_LIMIT": "3",
    // Cloudflare Access. The API refuses every request until both are set
    // (local dev skips this with DEV_NO_ACCESS=1 in .dev.vars).
    // ACCESS_TEAM_DOMAIN looks like "yourfamily.cloudflareaccess.com".
    // ACCESS_AUD is the "Application Audience (AUD) Tag" of the Access app.
    "ACCESS_TEAM_DOMAIN": "ssm-141921.cloudflareaccess.com",
    "ACCESS_AUD": "97974704d64697ae220fad1a1788166d448a81643722ea51e46d58538adf4bb0"
  },

  "observability": { "enabled": true }
}
