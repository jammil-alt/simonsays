{
  "name": "homework-desk",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler d1 migrations apply homework-db --remote && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply homework-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply homework-db --remote"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261106.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.158.0"
  }
}
